---
import { LEGAL_PAGES, SECTIONS, SITE, SITE_HOST } from '@/config/site'
import { getMessages, localePath, sectionHref, type Locale } from '@/i18n/locales'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getMessages(locale)
const pricingHref = sectionHref(locale, SECTIONS.pricing)
const f = t.footer
const stores = [
  {
    name: 'Google Play',
    href: SITE.stores.googlePlay,
    icon: '<path d="M4 3.5v17l9-8.5z" class="gp-1"/><path d="M4 3.5l12 6.8-3 2.2z" class="gp-2"/><path d="M4 20.5l12-6.8-3-1.2z" class="gp-3"/><path d="M16 10.3l3.6 2-3.6 2-3-1.8z" class="gp-4"/>',
  },
  {
    name: 'App Store',
    href: SITE.stores.appStore,
    icon: '<path fill="currentColor" d="M16.4 12.6c0-2.4 2-3.6 2.1-3.7-1.2-1.7-3-1.9-3.6-2-1.5-.2-3 .9-3.8.9s-2-.9-3.3-.9c-1.7 0-3.3 1-4.1 2.5-1.8 3.1-.5 7.6 1.3 10.1.8 1.2 1.8 2.6 3.1 2.5 1.3 0 1.7-.8 3.3-.8s2 .8 3.3.8c1.4 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8 0 0-2.6-1-2.6-4.2zM14 5.4c.7-.8 1.2-2 1-3.1-1 0-2.2.7-2.9 1.5-.6.7-1.2 1.9-1 3 1.1.1 2.2-.6 2.9-1.4z"/>',
  },
]
const socials = [
  {
    name: 'YouTube',
    href: SITE.socials.youtube,
    icon: '<rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="M10 9.5v5l4.5-2.5z" fill="currentColor"/>',
  },
  {
    name: 'Instagram',
    href: SITE.socials.instagram,
    icon: '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor"/>',
  },
  { name: 'Telegram', href: SITE.telegram.href, icon: '<path d="M21 4L3 11l6 2 2 6 3.5-4 4.5 3.5z"/><path d="M9 13l8-6"/>' },
]
---

<footer>
  <div class="wrap">
    <div class="f-grid">
      <div class="f-brand">
        <a class="brand" href={sectionHref(locale, SECTIONS.top)}><svg class="mark" aria-hidden="true"><use href="#zmark"></use></svg>ZUCCO</a>
        <p class="f-tagline">{f.tagline}</p>
      </div>
      <div>
        <h4>{f.apps}</h4>
        {stores.map((store) => {
          const content = (
            <>
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={store.icon}></svg>
              <span><small>{f.download}</small><b>{store.name}</b>{!store.href && <em>{f.soon}</em>}</span>
            </>
          )
          return store.href ? (
            <a class="store" href={store.href} target="_blank" rel="noopener">{content}</a>
          ) : (
            <div class="store">{content}</div>
          )
        })}
      </div>
      <div>
        <h4>{f.resources}</h4>
        <ul>
          <li><a href={sectionHref(locale, SECTIONS.features)}>{t.nav.features}</a></li>
          <li><a href={pricingHref}>{t.nav.pricing}</a></li>
          <li><a href={sectionHref(locale, SECTIONS.faq)}>{t.nav.faq}</a></li>
          <li><a href={SITE.appUrl} target="_blank" rel="noopener">{f.login}</a></li>
        </ul>
      </div>
      <div>
        <h4>{f.contacts}</h4>
        <ul>
          <li><a href={SITE.phone.href}>{SITE.phone.display}</a></li>
          <li><a href={SITE.telegram.href} target="_blank" rel="noopener">Telegram: {SITE.telegram.handle}</a></li>
          <li><a href={SITE.url}>{SITE_HOST}</a></li>
        </ul>
      </div>
      <div class="f-cta">
        <h4>{f.socials}</h4>
        <div class="socials">
          {socials.map((social) =>
            social.href ? (
              <a href={social.href} target="_blank" rel="noopener" aria-label={social.name}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true" set:html={social.icon}></svg>
              </a>
            ) : (
              <span class="soon" role="img" title={`${social.name} — ${f.soon}`} aria-label={`${social.name} — ${f.soon}`}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true" set:html={social.icon}></svg>
              </span>
            )
          )}
        </div>
        <div class="f-btns">
          <a class="btn btn-primary" href={sectionHref(locale, SECTIONS.demo)}>{t.nav.consult}</a>
          <a class="btn btn-dark" href={pricingHref}>{f.pay}</a>
        </div>
      </div>
    </div>
    <div class="f-bottom">
      <p>© {SITE.copyrightYear} <b>{SITE.name}</b></p>
      <p>{f.legal}</p>
      <nav class="f-docs" aria-label={t.legal.documents}>
        {LEGAL_PAGES.map((slug) => <a href={localePath(locale, slug)}>{t.legal[slug].title}</a>)}
      </nav>
    </div>
  </div>
</footer>
