---
import { getMessages, type Locale } from '@/i18n/locales'

interface Props {
  locale: Locale
}

const t = getMessages(Astro.props.locale).benefits
const items = [
  {
    ...t.support,
    icon: '<path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="3" y="14" width="4" height="6" rx="1.5"/><rect x="17" y="14" width="4" height="6" rx="1.5"/>',
  },
  {
    ...t.onboarding,
    icon: '<path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-5 4v-4.2A2.5 2.5 0 0 1 4 14.5z"/>',
  },
  { ...t.security, icon: '<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/>' },
  {
    ...t.interface,
    icon: '<circle cx="9" cy="8" r="3.5"/><path d="M3 19c0-3.3 2.7-5.5 6-5.5 1.5 0 2.9.5 4 1.2M15.5 17.5l2 2 4-4"/>',
  },
]
---

<section id="yordam">
  <div class="wrap">
    <div class="sec-head">
      <h2>{t.title}</h2>
      <p>{t.subtitle}</p>
    </div>
    <div class="benefits">
      {items.map((item) => (
        <div class="benefit">
          <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={item.icon}></svg></span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
