---
import { SECTIONS, SITE } from '@/config/site'
import { getMessages, type Locale } from '@/i18n/locales'

interface Props {
  locale: Locale
}

const t = getMessages(Astro.props.locale).hero
// Ilova ko'rinishidagi namuna raqamlar (KPI tartibi t.kpis bilan bir xil). 3-o'rin — qarzdorlar, qizil.
const KPI_VALUES = [184, 16, 9, 12, 141, 37]
const DEBT_KPI_INDEX = 2
const RAIL_ICONS = [
  '<rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="4" width="7" height="7" rx="1.5"/><rect x="4" y="13" width="7" height="7" rx="1.5"/><rect x="13" y="13" width="7" height="7" rx="1.5"/>',
  '<path d="M4 5h4v14H4zM10 5h4v9h-4zM16 5h4v5h-4z"/>',
  '<circle cx="9" cy="8" r="3.5"/><path d="M3 19c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5"/>',
  '<rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M3.5 10h17"/>',
  '<rect x="3" y="6" width="18" height="13" rx="2.5"/><path d="M3 10h18"/>',
  '<path d="M4 20V10M10 20V4M16 20v-7"/>',
]
const MONTH_X = [50, 188, 326, 468]
---

<section class="hero">
  <div class="wrap">
    <h1>{t.title}</h1>
    <p class="lead">{t.lead}</p>
    <div class="ctas">
      <a class="btn btn-hero" href={`#${SECTIONS.demo}`}>{t.primaryCta}</a>
      <a class="btn btn-outline" href={SITE.phone.href}><svg aria-hidden="true"><use href="#phone"></use></svg>{t.salesCta}</a>
    </div>

    <div class="stage" role="img" aria-label={t.mockLabel}>
      <div class="browser" aria-hidden="true">
        <div class="chrome"><span class="dots"><i></i><i></i><i></i></span><span class="url">{t.demoUrl}</span><span class="sample">{t.sample}</span></div>
        <div class="app">
          <aside class="rail">
            <svg class="mark"><use href="#zmark"></use></svg>
            {t.rail.map((label, index) => (
              <span class={index === 0 ? 'on' : undefined}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" set:html={RAIL_ICONS[index]}></svg>
                {label}
              </span>
            ))}
          </aside>
          <div class="dash">
            <div class="kpis">
              {t.kpis.map((label, index) => (
                <div class="kpi"><small>{label}</small><b class={index === DEBT_KPI_INDEX ? 'debt' : undefined}>{KPI_VALUES[index]}</b></div>
              ))}
            </div>
            <div class="chart">
              <div class="ct"><span>{t.chartTitle}</span><span>{t.chartUnit}</span></div>
              <svg viewBox="0 0 600 150" preserveAspectRatio="none">
                <line class="grid-line" x1="40" y1="20" x2="590" y2="20"></line><line class="grid-line" x1="40" y1="60" x2="590" y2="60"></line><line class="grid-line" x1="40" y1="100" x2="590" y2="100"></line>
                <text class="axis" x="4" y="24">60</text><text class="axis" x="4" y="64">45</text><text class="axis" x="4" y="104">30</text>
                <path class="area" d="M60 105 C140 95 160 70 200 72 S300 100 340 86 S440 58 480 54 S560 40 580 36 L580 130 L60 130Z"></path>
                <path class="line" d="M60 105 C140 95 160 70 200 72 S300 100 340 86 S440 58 480 54 S560 40 580 36"></path>
                <circle class="pt" cx="60" cy="105" r="4"></circle><circle class="pt" cx="200" cy="72" r="4"></circle><circle class="pt" cx="340" cy="86" r="4"></circle><circle class="pt" cx="480" cy="54" r="4"></circle><circle class="pt" cx="580" cy="36" r="5"></circle>
                {t.months.map((month, index) => <text class="axis" x={MONTH_X[index]} y="146">{month}</text>)}
              </svg>
            </div>
          </div>
        </div>
      </div>
      <div class="float" aria-hidden="true">
        <h4>{t.paymentsTitle}</h4>
        <div class="pay"><b>{t.payments}</b><small>{t.period}</small></div>
        <div class="pay"><b>{t.profit}</b><small>{t.period}</small></div>
      </div>
    </div>
  </div>
</section>
