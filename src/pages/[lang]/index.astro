---
import type { GetStaticPaths } from 'astro'
import LandingPage from '@/components/LandingPage.astro'
import { PREFIXED_LOCALES, isLocale } from '@/i18n/locales'

export const getStaticPaths = (() => PREFIXED_LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths

const { lang } = Astro.params
if (!isLocale(lang)) throw new Error(`Unknown locale: ${lang}`)
---

<LandingPage locale={lang} />
