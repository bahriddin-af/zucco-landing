---
import type { GetStaticPaths } from 'astro'
import LegalPage from '@/components/LegalPage.astro'
import { LEGAL_PAGES } from '@/config/site'
import { PREFIXED_LOCALES } from '@/i18n/locales'

export const getStaticPaths = (() =>
  PREFIXED_LOCALES.flatMap((lang) =>
    LEGAL_PAGES.map((legal) => ({ params: { lang, legal }, props: { locale: lang, slug: legal } })),
  )) satisfies GetStaticPaths

const { locale, slug } = Astro.props
---

<LegalPage locale={locale} slug={slug} />
